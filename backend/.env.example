# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=ticketflow_db
POSTGRES_HOST=ticketflow-postgres # PostgreSQL container name on ticketflow-net
POSTGRES_PORT=5432

DATABASE_URL=postgresql://ticketflow:replace-with-a-strong-database-password@ticketflow-postgres:5432/ticketflow_db

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=production            # development | production
FLASK_DEBUG=0                   # 1 only in dev
SECRET_KEY=replace-with-a-long-random-value

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-different-long-random-value
JWT_ACCESS_TOKEN_EXPIRES=3600   # seconds (1 hour)

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost

