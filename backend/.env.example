# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=ticketdb
POSTGRES_HOST=localhost        # service name in Docker network
POSTGRES_PORT=5432

DATABASE_URL=postgresql://ticketuser:Arslan123@localhost:5432/ticketdb

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=production            # development | production
FLASK_DEBUG=0                   # 1 only in dev
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES=3600   # seconds (1 hour)

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
